@{
    ViewBag.Title = "Cargar Datos Transaccionales";
}

<div class="container mt-4">
    <h2>@ViewBag.Title</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm("ProcesarArchivo", "Prima", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="form-group">
                    <label for="archivo">Seleccionar archivo Excel:</label>
                    <input type="file" name="archivo" id="archivo" class="form-control-file" accept=".xlsx,.xls" />
                    <small class="form-text text-muted">
                        El archivo debe contener las columnas: pol_txt_presentacion, pol_num_prima
                    </small>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Cargar Datos</button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
                </div>
            }
        </div>
    </div>

    <div class="alert alert-info mt-4">
        <h5>Instrucciones:</h5>
        <ul>
            <li>El archivo debe ser formato Excel (.xlsx o .xls)</li>
            <li>Debe contener las columnas: <strong>pol_txt_presentacion</strong> y <strong>pol_num_prima</strong></li>
            <li>Los registros con presentación vacía serán omitidos automáticamente</li>
            <li>Los tipos de INVALIDEZ se agruparán automáticamente</li>
        </ul>
    </div>
</div>